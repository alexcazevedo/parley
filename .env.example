# Copy to .env and fill in real values before running docker compose or
# `uv run` commands from the host. Postgres/Redis are published on
# non-default host ports (5434/6380; API on 8001) to avoid clashing with other local
# services; inside docker-compose, api/worker override these two vars to
# use the in-network hostnames (postgres:5432, redis:6379) automatically.

# Postgres connection (SQLAlchemy async, asyncpg driver) — host-side value
DATABASE_URL=postgresql+asyncpg://harness:harness@localhost:5434/harness

# Redis connection (queue, locks, debounce) — host-side value
REDIS_URL=redis://localhost:6380/0

# Demo mode mounts the demo surface: the built-in /chat page, the
# unauthenticated POST /chat/bootstrap (hands out a tenant key) and the
# /dev/* routes. Placeholder ADMIN_API_KEY / SECRETS_KEY values below only
# let the app boot when this is true; otherwise the API and worker refuse to
# start. Even then a placeholder SECRETS_KEY cannot encrypt: a channel with a
# `secret` or a tool with `auth_config` returns 500, so set a real SECRETS_KEY
# if you need those.
DEMO_MODE=false

# One shared admin key, required as X-Admin-Key to create tenants
ADMIN_API_KEY=changeme-admin-key

# Fernet key used to encrypt secrets at rest (generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
SECRETS_KEY=changeme-fernet-key-base64==

# OpenAI-compatible LLM provider
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=changeme-llm-key
LLM_MODEL=gpt-4o-mini

# Seconds to wait for more inbound messages before running an agent turn
DEBOUNCE_SECONDS=3

# structlog level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Postgres container credentials (used by docker-compose.yml for the postgres service)
POSTGRES_USER=harness
POSTGRES_PASSWORD=harness
POSTGRES_DB=harness

# SSRF guard for outbound customer-tool HTTP calls (see app/tools/ssrf.py).
# Comma-separated hostname allowlist; when set, only these hosts may be
# called by a tool endpoint (all others are refused; remove or extend it for
# real tools). docker-compose sets this to `mock-tools` for the
# api/worker containers so the demo's mocked business tool is reachable.
# Leave empty for the normal SSRF checks (block private/loopback/link-local
# addresses, allow everything else).
TOOL_ALLOWED_HOSTS=

# Set to true to disable the SSRF guard entirely. Development only — never
# do this outside a local/demo environment.
TOOL_SSRF_DISABLED=false

# Operator boundary floor: path to a JSON file applied to every agent of every
# tenant; tenants can add to it but not loosen it or switch the reply check
# off. Broken or missing file stops startup. Empty = no floor.
# Shape: {"scope": "<optional text>", "never": ["<text>", ...]}
# BOUNDARY_FLOOR_FILE=
